+import { parseWorkbook, processWorkbook } from "../src/import-engine/pipeline.ts";
+
+// Synthetic data only. No customer records or account numbers from user files.
+function fixture() {
+  const wb=XLSX.utils.book_new();
+  const put=(s:string,a:string,v:string|number)=>{wb.Sheets[s][a]={t:typeof v==="number"?"n":"s",v};};
+  for(const s of [...SONACOL_SHEETS,"MACRO BANCOS","REPORTE"]) XLSX.utils.book_append_sheet(wb,{"!ref":"A1:AB60"},s);
+  const headings:Record<string,Record<string,string>>={BANCO:{F:"FechaDocumento",J:"CtaCodigo",Z:"TesDocMontoImpuDebe",AA:"TesDocMontoImpuHaber"},BASE:{A:"TABLA ORIGEN",P:"DEBE",Q:"HABER"},CLIENTES:{F:"RutCliente",N:"NúmeroDocumento",T:"MontoImputacionDebe"},COLOCACIONES:{F:"RutCliente",T:"MontoImputacionDebe",Q:"FechaVencimiento"},PROYEC:{B:"FECHA",F:"DEBE",G:"HABER"}};
+  for(const [s,headers] of Object.entries(headings)) for(const [c,v] of Object.entries(headers)) put(s,c+"8",v);
+  for(const r of [9,10]) for(const [c,v] of Object.entries({B:1,C:1,D:1,E:125,F:46276,G:301,H:1,I:2,J:511010014,K:"Banco Itau $",L:1,U:"Pago",Z:0,AA:100})) put("BANCO",c+r,v);
+  put("BASE","A9","BANCO");put("BASE","S9","CONCILIADO");wb.Sheets.BASE.D9={t:"n",v:46276,f:"BANCO!F9"};
+  for(const [r,label,code] of [[10,"ITAU $",511010014],[11,"ITAU",511010016]] as const) {put("INVERSIONES","A"+r,label);put("INVERSIONES","B"+r,code+"   "+(label==="ITAU"?"Corpbanca":"Banco Itau $"));}
+  put("INVERSIONES","H28","ITAU");put("INVERSIONES","J28","000111");put("INVERSIONES","H29","ITAU $");put("INVERSIONES","J29","000222");
+  put("CUADRATURA BANCOS","B6","SALDOS BANCOS SONACOL AL");put("CUADRATURA BANCOS","F6",46277);
+  put("CUADRATURA BANCOS","B9","Itau $ 000222");put("CUADRATURA BANCOS","C9","Corpbanca 000111");
+  put("CUADRATURA BANCOS","A11","SALDO CONCILIADO");put("CUADRATURA BANCOS","A12","SALDO CONTABLE");
+  for(const c of ["B","C"]) for(const r of [11,12]) put("CUADRATURA BANCOS",c+r,500);
+  for(const [c,v] of Object.entries({F:"11111111-1",G:"Cliente de prueba",N:123,O:"CLP",P:46265,Q:46279,T:500,V:500})) put("CLIENTES",c+"9",v);
+  for(const [c,v] of Object.entries({G:"BCI",K:"FF.MM.",O:0,P:46265,Q:46279,T:1000,V:1000})) put("COLOCACIONES",c+"9",v);
+  wb.Sheets.CLIENTES.AA5000={t:"e",v:42};wb.Sheets.COLOCACIONES.AA5000={t:"e",v:42};
+  put("PROYEC","A9",1);put("PROYEC","H9",0);put("PROYEC","J9","PROVEEDORES");
+  put("PROYEC","E10",46279);put("PROYEC","G10",200);put("PROYEC","J10","PROVEEDORES");
