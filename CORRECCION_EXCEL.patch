@@ -0,0 +1,133 @@
+import * as XLSX from "xlsx";
+import { cellText, cellToDate, cellToNumber, isErrorCell } from "./detect";
+import { classifyCategory, normalizeBankName, normalizeCurrency, normalizeStatus } from "./normalize";
+import { validateRecord } from "./validate";
+import type { ImportEntityType } from "@/financial-engine/types";
+import type { WorkSheetData } from "./pipeline";
+
+export const SONACOL_SHEETS = ["BASE", "BANCO", "CLIENTES", "COLOCACIONES", "PROYEC", "INVERSIONES", "CUADRATURA BANCOS"];
+export const hasSonacolNames = (names: string[]) => SONACOL_SHEETS.every((s) => names.includes(s));
+const key = (v: unknown) => cellText(v).trim().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^A-Z0-9]/g, "");
+const text = (v: unknown) => cellText(v).trim();
+const num = (v: unknown) => cellToNumber(v);
+const date = (v: unknown) => cellToDate(v).iso;
+const active = (v: unknown) => isErrorCell(v) || (num(v) ?? 0) !== 0 || (!!text(v) && num(v) === null);
+const rows = (ws: XLSX.WorkSheet) => [...new Set(Object.keys(ws).filter((a) => /^[A-Z]+\d+$/.test(a)).map((a) => XLSX.utils.decode_cell(a).r + 1))].sort((a,b) => a-b);
+function header(ws: XLSX.WorkSheet, expected: Record<string,string>) {
+  return rows(ws).slice(0,60).find((r) => Object.entries(expected).every(([c,label]) => key(ws[c+r]) === key(label)));
+}
+
+/** This profile reads the source tables once. Pivot reports and macro staging
+ * copies must not create a second set of financial transactions. No macros run. */
+export function readSonacol(wb: XLSX.WorkBook): WorkSheetData[] {
+  const sheets = wb.Sheets;
+  const headers = {
+    BANCO: header(sheets.BANCO,{F:"FechaDocumento",J:"CtaCodigo",Z:"TesDocMontoImpuDebe",AA:"TesDocMontoImpuHaber"}),
+    CLIENTES: header(sheets.CLIENTES,{F:"RutCliente",N:"NúmeroDocumento",T:"MontoImputacionDebe"}),
+    COLOCACIONES: header(sheets.COLOCACIONES,{F:"RutCliente",T:"MontoImputacionDebe",Q:"FechaVencimiento"}),
+    PROYEC: header(sheets.PROYEC,{B:"FECHA",F:"DEBE",G:"HABER"}),
+    BASE: header(sheets.BASE,{A:"TABLA ORIGEN",P:"DEBE",Q:"HABER"}),
+  };
+  if (Object.values(headers).some((r) => !r)) throw new Error("Se reconoce un libro CAJA SONACOL, pero cambió la estructura de una tabla. No se importó nada: revisa la versión del formato con soporte.");
+  // Native numeric dates need the workbook's date system; never interpret the display string.
+  for (const ws of Object.values(sheets)) for (const [a,c] of Object.entries(ws)) {
+    if (/^[A-Z]+\d+$/.test(a)) (c as XLSX.CellObject & {date1904:boolean}).date1904 = !!wb.Workbook?.WBProps?.date1904;
